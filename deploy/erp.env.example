# Copy to /etc/erp/erp.env on the server, replace every placeholder value below, then:  sudo chown root:erp /etc/erp/erp.env && sudo chmod 640 /etc/erp/erp.env
# Rules: one KEY=value per line; put "double quotes" around any value containing spaces; never commit the real file to Git.
# Make each secret with:  openssl rand -hex 32     (hex is safe to put inside the database URLs below)

NODE_ENV=production
PORT=5000
COOKIE_SECURE=true
APP_URL=https://CHANGE-ME.duckdns.org

JWT_SECRET=CHANGE-ME
# The owner role runs migrations only. The app itself connects as erp_app, which cannot bypass tenant isolation.
MIGRATE_DATABASE_URL=postgres://erp_owner:CHANGE-ME-OWNER-PASSWORD@127.0.0.1:5432/planetu_erp
DATABASE_URL=postgres://erp_app:CHANGE-ME-APP-PASSWORD@127.0.0.1:5432/planetu_erp
APP_DB_PASSWORD=CHANGE-ME-APP-PASSWORD

# Uploaded documents live here (outside the Git checkout, so updates never touch them). Back this folder up.
UPLOAD_DIR=/var/lib/erp/uploads

# Email: "log" only prints emails into the server log. For real email use smtp and your provider's URL.
MAIL_TRANSPORT=log
# MAIL_TRANSPORT=smtp
# SMTP_URL=smtps://username:password@smtp.yourprovider.com:465
MAIL_FROM_ADDRESS=no-reply@CHANGE-ME.duckdns.org

# Printed on the GST invoices you send to institutes (fill in before you issue the first invoice)
BILLING_VENDOR_NAME="Your Company Name"
BILLING_VENDOR_ADDRESS="Street, City, PIN"
BILLING_VENDOR_STATE=Maharashtra
BILLING_VENDOR_GSTIN=
BILLING_VENDOR_PAN=
BILLING_VENDOR_EMAIL=billing@CHANGE-ME.duckdns.org
# BILLING_BANK_DETAILS="Bank, A/c no, IFSC"
# BILLING_UPI_ID=

# Optional: online payments (leave empty until you have Razorpay keys)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
