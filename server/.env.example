# Copy to .env and adjust. Every value has a safe development default.
PORT=5000
NODE_ENV=development
# REQUIRED in production - use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me
# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false

# --- PostgreSQL ------------------------------------------------------------
# The API connects as the restricted `erp_app` role (no superuser, no BYPASSRLS), so
# Row Level Security - the tenant isolation - is always enforced. Migrations run as
# the owner. The defaults below match docker-compose.yml. CHANGE ALL PASSWORDS in production.
DATABASE_URL=postgres://erp_app:erp_app_dev@localhost:5432/planetu_erp
MIGRATE_DATABASE_URL=postgres://erp_owner:erp_owner_dev@localhost:5432/planetu_erp
# Password the migration sets on the erp_app role (must match the one inside DATABASE_URL)
APP_DB_PASSWORD=erp_app_dev
# Development only: keep the demo institutes' dates anchored to today on every start
# DEMO_REFRESH=true

# --- Google reCAPTCHA v2 ("I'm not a robot" checkbox) --------------------
# Leave both blank to keep using the built-in custom human check.
# Get these from https://www.google.com/recaptcha/admin/create
#   - choose "reCAPTCHA v2" -> "I'm not a robot" Checkbox
#   - add localhost as a domain for local testing
# RECAPTCHA_SITE_KEY is public (safe in the browser); RECAPTCHA_SECRET_KEY
# must never be exposed to the client.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Email --------------------------------------------------------------------
# 'log' prints mail to the API console (fine for development). Use 'smtp' in production, otherwise
# password-reset links, account-setup links and admission updates will NOT reach anyone.
MAIL_TRANSPORT=log
# SMTP_URL=smtps://username:password@smtp.yourprovider.com:465
# Sender address (each mail shows the institute's name as the sender name). Use a domain you own and
# set up SPF/DKIM for it, or mail will land in spam.
MAIL_FROM_ADDRESS=no-reply@planetu.example
# Public address of the web app - used for the links inside emails
APP_URL=http://localhost:5173
# Set false to stop this process delivering mail (e.g. if you run a separate worker later)
# MAIL_WORKER=false
# How often the mail outbox is checked, in seconds (default 15). Raise to 300-600 on a database that sleeps when idle (e.g. Neon free).
# MAIL_POLL_SECONDS=15

# --- Razorpay (online fee payments: UPI, cards, netbanking) ----------------------
# Create keys at https://dashboard.razorpay.com (use Test Mode first; keys start with rzp_test_).
# Leave blank to switch online payment off - students then see no "Pay online" button and
# admins keep recording payments manually as before.
#   RAZORPAY_KEY_ID          public, safe in the browser
#   RAZORPAY_KEY_SECRET      server only - never commit the real one
#   RAZORPAY_WEBHOOK_SECRET  any long random string; paste the same value into
#                            Dashboard > Settings > Webhooks (URL: https://<your-domain>/api/webhooks/razorpay,
#                            events: payment.captured, order.paid, payment.failed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
# Vendor billing: PlanetU charging each institute a subscription.
# Subscriptions are paid with the SAME Razorpay keys as fees (above): nothing extra to configure there.
# These are the ISSUER's details, printed on every tax invoice. Take the GST fields from your CA.
# ---------------------------------------------------------------------------
BILLING_VENDOR_NAME=PlanetU Technologies
BILLING_VENDOR_ADDRESS=
# Your registered state, exactly as in the list in the console (decides CGST+SGST vs IGST)
BILLING_VENDOR_STATE=Maharashtra
BILLING_VENDOR_GSTIN=
BILLING_VENDOR_PAN=
BILLING_VENDOR_EMAIL=billing@yourdomain.example
# Service accounting code and GST rate printed on invoices - confirm both with your CA
BILLING_SAC=998314
BILLING_GST_RATE=18
BILLING_INVOICE_PREFIX=PU
# Shown on invoices for customers who prefer to pay by bank transfer / UPI instead of online
BILLING_BANK_DETAILS=
BILLING_UPI_ID=
# Timing (days). Invoice goes out this long before the period ends; trial length; grace after the due date before locking.
BILLING_INVOICE_LEAD_DAYS=7
BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=7
# Set to false to stop the daily billing run in this process (e.g. when running several API instances)
BILLING_WORKER=true

# --- Production reminders ---
# On a real server NEVER run `npm run db:setup` (it creates demo logins with published passwords; it refuses in production).
# Use `npm run db:migrate` and then `npm run create-vendor -- --login=... --email=...` to create your platform-owner account.

# --- Hosts with one database login / no persistent disk / no shell (e.g. Render free plan). See RENDER.md ---
# DB_SINGLE_ROLE=true            # the app runs as the account that owns the tables (no separate erp_app role)
# STORAGE_DRIVER=db              # keep uploaded files inside PostgreSQL instead of a folder (default: local)
# TRUST_PROXY_HOPS=1             # proxies in front of the app; check at /api/super-admin/diagnostics/network
# VENDOR_LOGIN=...  VENDOR_EMAIL=...  VENDOR_PASSWORD=...   # creates the owner account at start-up if it is missing
# VENDOR_RESET=true              # with a new VENDOR_PASSWORD: change that account's password (then remove both)
# DEMO_MODE=true              # public demo: loads the 3 sample institutes if missing + one-click sign-ins on the login page (never the owner account)
# DEMO_RESET_ON_START=true     # with DEMO_MODE: rebuild the sample institutes on every start
