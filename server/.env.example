# Copy to .env and adjust. Every value has a safe development default.
PORT=5000
NODE_ENV=development
# REQUIRED in production - use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me
# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false

# --- Google reCAPTCHA v2 ("I'm not a robot" checkbox) --------------------
# Leave both blank to keep using the built-in custom human check.
# Get these from https://www.google.com/recaptcha/admin/create
#   - choose "reCAPTCHA v2" -> "I'm not a robot" Checkbox
#   - add localhost as a domain for local testing
# RECAPTCHA_SITE_KEY is public (safe in the browser); RECAPTCHA_SECRET_KEY
# must never be exposed to the client.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
